# Required for the AI document reader. Free key: https://aistudio.google.com/app/apikey
GEMINI_API_KEY=
# Optional. If this model is not available on your key, the app tries the next ones automatically.
GEMINI_MODEL=gemini-3.6-flash

# Optional: really send the vendor emails (Gmail example uses an app password).
# SMTP_HOST=smtp.gmail.com
# SMTP_USER=you@gmail.com
# SMTP_PASS=your-app-password
# DEMO_MAIL_TO=you@gmail.com     # send every vendor email here instead of the fictional addresses

# Optional: how long each stage stays on screen, in milliseconds (display only).
# STAGE_PACE_MS=500
# Reasoning depth for Gemini 3.x: minimal (fastest), low, medium, high
GEMINI_THINKING=minimal
